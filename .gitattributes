# Files are authored on Windows but executed inside WSL, Linux and Docker.
# Normalise everything to LF in the repository so bash never sees a stray \r,
# and check it out as LF too.
* text=auto eol=lf

# PowerShell is the one exception: it runs on the Windows side only.
*.ps1 text eol=crlf

# Never touch these.
*.png  binary
*.jpg  binary
*.gif  binary
*.web  binary
*.bin  binary
